{
  "name": "@lodz/seam-router",
  "version": "0.1.2",
  "description": "Deterministic capital routing across BTC yield seams on Solana. Enforces per-posture ceilings on counterparty-funded, emission-funded and uncorrelated LP exposure, routes on trailing rates rather than spot, and never treats an unmeasured impermanent loss as zero.",
  "keywords": [
    "solana",
    "btcfi",
    "yield",
    "allocation",
    "rebalancing",
    "impermanent-loss",
    "lodz"
  ],
  "license": "MIT",
  "author": "LODZ",
  "homepage": "https://lodz.money",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LodzMoney/lodz-sdk.git",
    "directory": "packages/seam-router"
  },
  "bugs": {
    "url": "https://github.com/LodzMoney/lodz-sdk/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/dist-manifests.mjs",
    "build:dev": "tsc -p tsconfig.dev.json",
    "pretest": "npm run build:dev",
    "test": "node --test \".dev/test/**/*.test.js\"",
    "demo": "npm run build:dev && node .dev/examples/scenario.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.9.3"
  }
}
