{
  "name": "@lodz/headlamp-risk",
  "version": "0.1.1",
  "description": "Layered bridge, custody, protocol, oracle and liquidity risk assessment for BTC positions on Solana.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://lodz.money",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LodzMoney/lodz-sdk.git",
    "directory": "packages/headlamp-risk"
  },
  "bugs": {
    "url": "https://github.com/LodzMoney/lodz-sdk/issues"
  },
  "keywords": [
    "bitcoin",
    "solana",
    "risk",
    "custody",
    "bridge"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('.tmp-test',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/stamp-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test .tmp-test/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lodz/assay-engine": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
